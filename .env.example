# ETHEREUM mainnet RPC (not Robinhood) used by /api/eligibility and
# /api/voucher to read a wallet's nonce at historical block 13527858. Must be
# archive-capable — Alchemy/Infura free tiers work; most keyless public RPCs
# prune historical state or rate-limit under load.
#
# NOTE: Robinhood Chain also has a "mainnet", and Alchemy will happily give
# you an endpoint for it. Pointed there, the nonce lookup does not error — it
# returns 0, so every OG is silently reported ineligible and quoted full
# price. The app now checks the chain id and refuses to answer, but pick the
# Ethereum endpoint (eth-mainnet.g.alchemy.com), not robinhood-mainnet.
MAINNET_RPC_URL=

# Optional keyed RPC for Robinhood Chain itself, used for the mint. The
# public endpoint works; a keyed one is steadier under load.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Deployed ArtPlumber address on the chain named below. Leave empty until the
# contract is deployed: the site then shows "Minting isn't live yet" instead
# of a button that cannot work.
NEXT_PUBLIC_ART_PLUMBER_ADDRESS=

# Which Robinhood chain the mint goes to: 46630 (testnet) or 4663 (mainnet).
# Anything else — including a typo — falls back to testnet, so a bad value
# sends people to play money rather than real money.
NEXT_PUBLIC_MINT_CHAIN_ID=46630

# Private key of the contract's immutable `signer`, used to sign EIP-712
# vouchers granting the OG free mint. Generate with `cast wallet new` and
# deploy the matching ADDRESS as the contract's constructor arg.
#
# SERVER-ONLY — never prefix with NEXT_PUBLIC_. It cannot be rotated: the
# contract has no owner, so a leak means redeploying. Keep the real value in
# a secret manager or the deployment platform's env, never in a tracked file.
ELIGIBILITY_SIGNER_PRIVATE_KEY=
