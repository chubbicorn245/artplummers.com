# Ethereum mainnet RPC used by /api/eligibility and /api/voucher to read a
# wallet's nonce at a historical block (13527858). Must be archive-capable —
# Alchemy/Infura free tiers work; most keyless public RPCs prune historical
# state.
MAINNET_RPC_URL=

# Deployed ArtPlumber address on Robinhood Chain testnet (chain id 46630).
# Leave empty until the contract is deployed: the site then shows "Minting
# isn't live yet" instead of a button that cannot work.
NEXT_PUBLIC_ART_PLUMBER_ADDRESS=

# Private key of the contract's immutable `signer`, used to sign EIP-712
# vouchers granting the OG free mint. Generate with `cast wallet new` and
# deploy the matching ADDRESS as the contract's constructor arg.
#
# SERVER-ONLY — never prefix with NEXT_PUBLIC_. It cannot be rotated: the
# contract has no owner, so a leak means redeploying. Keep the real value in
# a secret manager or the deployment platform's env, never in a tracked file.
ELIGIBILITY_SIGNER_PRIVATE_KEY=
